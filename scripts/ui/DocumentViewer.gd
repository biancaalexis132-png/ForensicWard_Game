class_name DocumentViewer
extends Control
## DocumentViewer: shows the paper image of a document the player read or
## picked up (a clue), or its text when no image exists.
##
## Images live at res://assets/documents/<clue_id>.png (generated by
## tools/documents/render_documents.py; see
## assets/asset_manifest/document_images_manifest.json). An image is loaded
## only when shown and released by clear(), so at most one document texture
## is held at a time (8 GB target machines).
##
## Fit shows the whole page; clicking the page or the Zoom button fits it to
## the width instead, and the page scrolls.

const DOCUMENT_DIR: String = "res://assets/documents/"
const PAPER: Color = Color(0.93, 0.91, 0.86)
const INK: Color = Color(0.13, 0.15, 0.18)

## The image path being shown, or "" for none or the text fallback.
var shown_path: String = ""
var zoomed: bool = false

var _scroll: ScrollContainer
var _page: TextureRect
var _fallback: PanelContainer
var _fallback_text: RichTextLabel
var _zoom_button: Button
var _hint: Label


## The document image for a clue, or "" when it has none.
static func image_path(clue_id: String) -> String:
	if clue_id.is_empty():
		return ""
	var path: String = DOCUMENT_DIR + clue_id + ".png"
	return path if ResourceLoader.exists(path) else ""


func _init() -> void:
	name = "DocumentViewer"
	mouse_filter = Control.MOUSE_FILTER_PASS
	var frame: PanelContainer = PanelContainer.new()
	frame.set_anchors_preset(Control.PRESET_FULL_RECT)
	var frame_style: StyleBoxFlat = UIStyle.panel_style(0.92)
	frame_style.set_content_margin_all(12)
	frame.add_theme_stylebox_override("panel", frame_style)
	add_child(frame)
	var column: VBoxContainer = VBoxContainer.new()
	column.add_theme_constant_override("separation", 8)
	frame.add_child(column)
	_scroll = ScrollContainer.new()
	_scroll.name = "Scroll"
	_scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	column.add_child(_scroll)
	_page = TextureRect.new()
	_page.name = "Page"
	_page.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	_page.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	_page.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_page.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_page.mouse_filter = Control.MOUSE_FILTER_STOP
	_page.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	_page.gui_input.connect(_on_page_input)
	_scroll.add_child(_page)
	_fallback = PanelContainer.new()
	_fallback.name = "TextFallback"
	var paper: StyleBoxFlat = StyleBoxFlat.new()
	paper.bg_color = PAPER
	paper.set_corner_radius_all(3)
	paper.set_content_margin_all(36)
	paper.shadow_color = Color(0, 0, 0, 0.5)
	paper.shadow_size = 8
	_fallback.add_theme_stylebox_override("panel", paper)
	_fallback.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_fallback_text = RichTextLabel.new()
	_fallback_text.bbcode_enabled = true
	_fallback_text.fit_content = false
	for font: String in ["normal_font_size", "bold_font_size", "italics_font_size"]:
		_fallback_text.add_theme_font_size_override(font, 24)
	_fallback_text.add_theme_color_override("default_color", INK)
	_fallback.add_child(_fallback_text)
	column.add_child(_fallback)
	var bar: HBoxContainer = HBoxContainer.new()
	_hint = UIStyle.label("Click the page to zoom.", 18, UIStyle.MUTED)
	_hint.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bar.add_child(_hint)
	_zoom_button = UIStyle.secondary_button("Zoom in", 18)
	_zoom_button.name = "Zoom"
	_zoom_button.pressed.connect(func() -> void: set_zoomed(not zoomed))
	bar.add_child(_zoom_button)
	column.add_child(bar)
	_scroll.resized.connect(_layout_page)
	clear()


## Shows a clue's document image, or `fallback_text` (BBCode) on a paper
## card when it has none. Returns true when an image is shown.
func show_document(clue_id: String, title: String, fallback_text: String) -> bool:
	clear()
	shown_path = image_path(clue_id)
	if not shown_path.is_empty():
		_page.texture = load(shown_path) as Texture2D
	if _page.texture == null:
		shown_path = ""
		_fallback_text.text = ("[b]%s[/b]\n\n" % title if not title.is_empty() else "") + fallback_text
	_scroll.visible = _page.texture != null
	_fallback.visible = _page.texture == null
	_zoom_button.visible = _page.texture != null
	_hint.visible = _page.texture != null
	set_zoomed(false)
	return _page.texture != null


func has_image() -> bool:
	return _page.texture != null


func get_fallback_text() -> String:
	return _fallback_text.get_parsed_text() if _fallback.visible else ""


## Drops the texture so the image can be freed.
func clear() -> void:
	_page.texture = null
	shown_path = ""
	_fallback_text.text = ""
	_fallback.visible = false
	_scroll.visible = false


func set_zoomed(value: bool) -> void:
	zoomed = value and _page.texture != null
	_zoom_button.text = "Fit page" if zoomed else "Zoom in"
	_hint.text = "Scroll to read; click the page to fit it again." if zoomed else "Click the page to zoom."
	_layout_page()
	_scroll.scroll_vertical = 0


func _layout_page() -> void:
	if _page.texture == null or not zoomed:
		_page.custom_minimum_size = Vector2.ZERO
		return
	var texture_size: Vector2 = _page.texture.get_size()
	var width: float = maxf(_scroll.size.x - 16.0, 1.0)
	_page.custom_minimum_size = Vector2(width, width * texture_size.y / texture_size.x)


func _on_page_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed and (event as InputEventMouseButton).button_index == MOUSE_BUTTON_LEFT:
		set_zoomed(not zoomed)
		accept_event()
