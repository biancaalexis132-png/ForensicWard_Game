  "face_shapes": {
    "notes": "Morph targets on the face mesh. Expression shapes are authored at the intensity used in game (the acting adapter sets them to 1.0). Lid values are degrees of eyelid rotation over the eyeball (positive closes); other values are millimetres in the character frame.",
    "blink": {"close_fraction": 1.0, "lower_lid_share": 0.12, "overlap_deg": 3.0},
    "expressions": {
      "attentive":              {"brow_raise": 1.4, "lid": -3.0},
      "warm_subtle":            {"mouth_corner_up": 2.2, "mouth_corner_back": 1.0, "cheek_up": 1.1, "lower_lid": 3.0},
      "concerned_restrained":   {"inner_brow_raise": 1.3, "brow_knit": 0.8, "mouth_corner_up": -0.6},
