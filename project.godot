; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Forensic Ward"
config/description="First-person psychological thriller and forensic psychiatry simulation."
config/version="0.1.0-sprint1"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
Settings="*res://scripts/autoload/Settings.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
ContentRegistry="*res://scripts/autoload/ContentRegistry.gd"
TimeManager="*res://scripts/autoload/TimeManager.gd"
PatientManager="*res://scripts/autoload/PatientManager.gd"
ClinicalRules="*res://scripts/autoload/ClinicalRules.gd"
DialogueManager="*res://scripts/autoload/DialogueManager.gd"
EvidenceManager="*res://scripts/autoload/EvidenceManager.gd"
TrustManager="*res://scripts/autoload/TrustManager.gd"
WorldStateManager="*res://scripts/autoload/WorldStateManager.gd"
GameState="*res://scripts/autoload/GameState.gd"
PharmacologyEngine="*res://systems/pharmacology/PharmacologyEngine.gd"
AudioDirector="*res://systems/audio/AudioDirector.gd"
CaseJournal="*res://scripts/narrative/CaseJournal.gd"
ProtagonistProfile="*res://scripts/protagonist/ProtagonistProfile.gd"
ContinuingPractice="*res://scripts/practice/ContinuingPractice.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[forensic_ward]

clinical/build_mode="prototype"
narrative/anomaly_enabled=false

