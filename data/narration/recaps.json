      "estimated_seconds": 8.4,
      "duration_seconds": 8.4
    },
    "nar_ch01_p02": {
      "id": "nar_ch01_p02",
      "chapter_id": "ch1",
      "panel_id": "p02",
      "text": "Behind the secured doors, the ward continues its daily rhythm. Every task belongs to someone, and every handoff matters.",
      "audio_path": "res://audio/narration/ch01/nar_ch01_p02.ogg",
      "cues": [
        {
          "start": 0.0,
          "end": 8.2,
          "text": "Behind the secured doors, the ward continues its daily rhythm. Every task belongs to someone, and every handoff matters."
